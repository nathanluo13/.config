# Restart the Wacom tablet driver. Fixes the "Bluetooth connected but pen does
# nothing" state (driver loses its input pipe, esp. after a macOS update).
# IMPORTANT: bounce ONLY the driver — do NOT also restart Wacom_IOManager, or
# the driver desyncs from the IO bridge and the tablet stops again.
wacom-restart() {
  launchctl kickstart -k "gui/$(id -u)/com.wacom.wacomtablet" \
    && echo "Wacom driver restarted — try the pen." \
    || echo "Failed to restart Wacom driver."
}
alias wacomfix='wacom-restart'
{{ end }}
# Roots that `cdf` fuzzy-searches. Edit this list freely.
CDF_ROOTS=(
{{- if eq .chezmoi.os "darwin" }}
  "$HOME/nuu"
  "$HOME/c"
  "$HOME/device"
  "$HOME/unimelb"
{{- else if eq .chezmoi.os "linux" }}
  "$HOME/c"
  "$HOME/device"
  "$HOME/src"
  "$HOME/work"
  "/mnt/c/Users/{{ .chezmoi.username }}"
{{- end }}
)
CDF_DEPTH=3

# Fuzzy-pick a directory under CDF_ROOTS and cd into it.
cdf() {
  local dir
  dir=$(fd -t d -u -d "${CDF_DEPTH:-3}" . "${CDF_ROOTS[@]}" 2>/dev/null \
        | fzf --height 40% --reverse --preview 'ls -la {}') || return
  cd "$dir"
}

