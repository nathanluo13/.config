#!/usr/bin/env bash
set -euo pipefail

log() {
  printf '\033[1;34m==>\033[0m %s\n' "$*"
}

warn() {
  printf '\033[1;33mwarn:\033[0m %s\n' "$*" >&2
}

run_git_update() {
  local dir=$1
  local name=$2

  if [ ! -d "$dir/.git" ]; then
    return 0
  fi

  log "Updating ${name}"
  git -C "$dir" pull --ff-only || warn "Could not fast-forward ${name}; review $dir"
}

if [ "$(uname -s)" = "Darwin" ] && command -v brew >/dev/null 2>&1; then
  # shellcheck disable=SC2046
  eval "$(/opt/homebrew/bin/brew shellenv)"

  brewfile="$HOME/.config/homebrew/Brewfile"
  if [ -f "$brewfile" ]; then
    log "Trusting Brewfile taps"
    grep -E '^tap "' "$brewfile" | sed -E 's/^tap "([^"]+)".*/\1/' | while read -r tap; do
      brew trust "$tap" >/dev/null 2>&1 || true
    done

    log "Updating Homebrew and Brewfile tools"
    brew update
    brew bundle --file="$brewfile"
    brew upgrade
    brew cleanup
  else
    warn "No Brewfile at $brewfile"
  fi
fi

run_git_update "$HOME/.oh-my-zsh" "oh-my-zsh"
run_git_update "$HOME/.local/share/tmux/oh-my-tmux" "oh-my-tmux"
run_git_update "$HOME/.config/tmux/plugins/tmux-dotbar" "tmux-dotbar"

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck disable=SC1091
  . "$NVM_DIR/nvm.sh"
  log "Updating Node LTS"
  nvm install --lts
  nvm alias default 'lts/*' >/dev/null

  if command -v npm >/dev/null 2>&1; then
    log "Updating npm globals"
    npm update -g
  fi

  if command -v corepack >/dev/null 2>&1; then
    corepack enable >/dev/null 2>&1 || true
  fi
fi

log "Tool update complete"
