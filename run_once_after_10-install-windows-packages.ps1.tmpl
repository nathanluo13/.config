{{ if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = "Stop"

$wingetPackages = Join-Path $HOME ".config\winget\packages.json"
if ((Get-Command winget -ErrorAction SilentlyContinue) -and (Test-Path -LiteralPath $wingetPackages)) {
    winget import -i $wingetPackages --accept-package-agreements --accept-source-agreements
}

if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
    Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser -Force
    Invoke-RestMethod -Uri https://get.scoop.sh | Invoke-Expression
}

if (Get-Command scoop -ErrorAction SilentlyContinue) {
    scoop bucket add main | Out-Null
    scoop install btop
}
{{ end -}}
