{{ if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = "Stop"

$wingetPackages = Join-Path $HOME ".config\winget\packages.json"
if ((Get-Command winget -ErrorAction SilentlyContinue) -and (Test-Path -LiteralPath $wingetPackages)) {
    $skipDuringBootstrap = @(
        # Updating Tailscale from a remote SSH session can interrupt or hang the
        # connection. Keep it in the inventory, but handle upgrades manually.
        "Tailscale.Tailscale"
    )
    $import = Get-Content -LiteralPath $wingetPackages -Raw | ConvertFrom-Json
    foreach ($source in $import.Sources) {
        $source.Packages = @(
            $source.Packages | Where-Object {
                $skipDuringBootstrap -notcontains $_.PackageIdentifier
            }
        )
    }

    $tempImport = Join-Path $env:TEMP "chezmoi-winget-import.json"
    $import | ConvertTo-Json -Depth 16 | Set-Content -LiteralPath $tempImport -Encoding UTF8
    winget import -i $tempImport --ignore-unavailable --accept-package-agreements --accept-source-agreements --disable-interactivity
}

if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
    Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser -Force
    $scoopInstaller = Join-Path $env:TEMP "install-scoop.ps1"
    Invoke-WebRequest -UseBasicParsing -Uri https://get.scoop.sh -OutFile $scoopInstaller

    $principal = [Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()
    $isAdmin = $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
    if ($isAdmin) {
        & $scoopInstaller -RunAsAdmin
    } else {
        & $scoopInstaller
    }
}

if (Get-Command scoop -ErrorAction SilentlyContinue) {
    scoop bucket add main | Out-Null
    $btopAppDir = Join-Path $HOME "scoop\apps\btop"
    if (-not (Test-Path -LiteralPath $btopAppDir)) {
        scoop install btop
    }
}
{{ end -}}
