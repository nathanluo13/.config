# >>> orbh shell-integration >>>
# Managed by `flint setup shell-integration`. Keeps non-Orbh terminal tabs
# titled "Terminal" so the NUU Orbit dashboard can read their status. Inside
# an active Orbh session the orbh wrapper owns the title, so this no-ops there.
autoload -Uz add-zsh-hook
_orbh_static_title() {
  [[ -n "$ORBH_SESSION_ID" ]] && return
  print -Pn "\e]0;Terminal\a"
}
add-zsh-hook precmd _orbh_static_title
# <<< orbh shell-integration <<<

